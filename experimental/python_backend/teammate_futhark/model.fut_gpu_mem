fun
  sigmoid_285 (x_284 : f32)
  : {f32#([0], [0])} = {
  let {binop_7955 : f32} =
    fsub32(0.0f32, x_284)
  let {binop_7956 : f32} =
    fpow32(2.7182817f32, binop_7955)
  let {binop_7957 : f32} =
    fadd32(1.0f32, binop_7956)
  let {binop_7958 : f32} =
    fdiv32(1.0f32, binop_7957)
  in {binop_7958}
}

fun
  mish_283 (x_282 : f32)
  : {f32#([0], [0])} = {
  let {exp32_19565 : f32} =
    apply exp32(x_282)
    : {f32}
  let {binop_19566 : f32} =
    fadd32(1.0f32, exp32_19565)
  let {log32_19567 : f32} =
    apply log32(binop_19566)
    : {f32}
  let {tanh32_7953 : f32} =
    apply tanh32(log32_19567)
    : {f32}
  let {binop_7954 : f32} =
    fmul32(x_282, tanh32_7953)
  in {binop_7954}
}

